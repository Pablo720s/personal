<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calificar en Google</title>

  <!-- Preconexión DNS ultrarrápida a Google -->
  <link rel="preconnect" href="https://search.google.com" crossorigin>
  <link rel="dns-prefetch" href="https://search.google.com">

  <!-- Redirección HTTP instantánea -->
  <meta http-equiv="refresh" content="0; url=https://search.google.com/local/writereview?placeid=ChIJVb3jwWd10oUREB9WOFcS9Fo">

  <!-- Redirección JavaScript en el head (se ejecuta antes de pintar el DOM) -->
  <script>
    const urlDestino = "https://search.google.com/local/writereview?placeid=ChIJVb3jwWd10oUREB9WOFcS9Fo";
    window.location.replace(urlDestino);
  </script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #061121;
      color: #ffffff;
      min-height: 100dvh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      text-align: center;
    }

    .card {
      width: 100%;
      max-width: 320px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-top: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 20px;
      padding: 30px 20px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
    }

    .spinner {
      width: 42px;
      height: 42px;
      border: 3px solid rgba(255, 255, 255, 0.15);
      border-top-color: #38bdf8;
      border-radius: 50%;
      animation: girar 0.7s linear infinite;
      margin: 0 auto 18px;
    }

    @keyframes girar {
      to {
        transform: rotate(360deg);
      }
    }

    h1 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    p {
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 20px;
      line-height: 1.4;
    }

    .btn-manual {
      display: inline-block;
      text-decoration: none;
      background-color: #ffffff;
      color: #061121;
      font-size: 0.88rem;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      transition: transform 0.15s ease, background-color 0.15s ease;
      width: 100%;
    }

    .btn-manual:active {
      background-color: #e2e8f0;
      transform: scale(0.98);
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="spinner"></div>
    <h1>Abriendo formulario</h1>
    <p>Redirigiendo a Google para calificar...</p>
    <a href="https://search.google.com/local/writereview?placeid=ChIJVb3jwWd10oUREB9WOFcS9Fo" class="btn-manual">
      Calificar ahora
    </a>
  </div>

</body>
</html>
